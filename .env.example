FLASK_ENV=development
SECRET_KEY=replace_with_a_secure_random_value

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=
# A currently-available Gemini Flash model, e.g. gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash
# (Optional) Pre-created File Search store ID; leave blank to auto-create
GEMINI_FILE_SEARCH_STORE=

# ── Sarvam AI ─────────────────────────────────────────────────────────────────
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v2
SARVAM_TTS_MODEL=bulbul:v2

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_PATH=instance/jarvis.db

# ── Defaults ──────────────────────────────────────────────────────────────────
DEFAULT_LANGUAGE=en-IN
MAX_AGENT_STEPS=8
MAX_RETRIES=2
REQUEST_TIMEOUT_SECONDS=30
MAX_AUDIO_SECONDS=30
MAX_AUDIO_UPLOAD_MB=10
MAX_CONCURRENT_RUNS=2
